# Microsoft Azure App Registration credentials
# Register your app at: https://portal.azure.com → Azure Active Directory → App registrations
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here
AZURE_TENANT_ID=your_tenant_id_here

# Microsoft Graph API scope (leave as-is)
GRAPH_SCOPE=https://graph.microsoft.com/.default

# Anthropic Claude API key
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: specific Teams user to scrape (your own email)
TARGET_USER_EMAIL=your_email_here
